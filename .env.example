# ─── Supabase Configuration ──────────────────────────────────────────────────
# Copy this file to .env and fill in the two values from your Supabase project.
# You can find both in your Supabase Dashboard:
#   Project Settings → Data API → Project URL         (VITE_SUPABASE_URL)
#   Project Settings → Data API → Project API Keys    (VITE_SUPABASE_ANON_KEY, the "anon public" key)
#
# Never commit the real .env file — it is git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
